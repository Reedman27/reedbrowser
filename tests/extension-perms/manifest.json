{
  "manifest_version": 2,
  "name": "Reed Permission Test",
  "version": "1.0",
  "browser_specific_settings": { "gecko": { "id": "reedperms@example.org" } },
  "description": "Declares only 'storage' and one host. Everything else must be refused.",
  "permissions": ["storage", "http://127.0.0.1:8099/*"],
  "browser_action": { "default_popup": "popup.html", "default_title": "perms" }
}
